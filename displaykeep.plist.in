<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tangentyh.displaykeep</string>
	<key>ProgramArguments</key>
	<array>
		<string>@BIN@</string>
		<string>-i</string>
		<string>@INTERVAL@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/tmp/displaykeep.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/displaykeep.log</string>
	<key>Nice</key>
	<integer>5</integer>
</dict>
</plist>
