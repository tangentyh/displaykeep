<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>@LABEL@</string>
	<key>ProgramArguments</key>
	<array>
		<string>@BIN@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- restart on crash, but not after a clean "Quit" from the menu bar -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<!-- Interactive: this process owns a status item, Background would invite App Nap -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<!-- No StandardOutPath/StandardErrorPath on purpose: the app opens the log itself
	     (see openLogFile in DisplayKeep.swift) so that a login-item launch — which has no
	     plist at all — logs to the same file. Pointing both at one file is harmless
	     (both append) but redundant. -->
	<key>Nice</key>
	<integer>5</integer>
</dict>
</plist>
