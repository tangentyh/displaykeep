<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>@LABEL@</string>
	<key>ProgramArguments</key>
	<array>
		<string>@BIN@</string>
		<string>-i</string>
		<string>@INTERVAL@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- restart on crash, but not after a clean "Quit" from the menu bar -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<!-- Interactive: this process owns a status item, Background would invite App Nap -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>StandardOutPath</key>
	<string>/tmp/displaykeep.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/displaykeep.log</string>
	<key>Nice</key>
	<integer>5</integer>
</dict>
</plist>
